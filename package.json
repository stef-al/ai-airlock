{
  "name": "ai-airlock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline, browser-only masking of sensitive data before pasting into AI chatbots",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "test": "vitest run --reporter=dot",
    "metrics": "tsx scripts/metrics.ts",
    "smoke": "node scripts/smoke.mjs",
    "gen:names": "tsx scripts/gen-names.ts",
    "predev": "npm run gen:names --silent",
    "pretest": "npm run gen:names --silent",
    "prebuild": "npm run gen:names --silent",
    "premetrics": "npm run gen:names --silent"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
