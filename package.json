{
  "name": "ai-airlock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline, browser-only masking of sensitive data before pasting into AI chatbots",
  "scripts": {
    "dev": "vite",
    "dev:media": "vite --mode media",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --mode media && node scripts/check-dist.mjs",
    "test": "vitest run --reporter=dot",
    "metrics": "tsx scripts/metrics.ts",
    "metrics:media": "tsx scripts/metrics-media.ts",
    "metrics:office": "tsx scripts/metrics-office.ts",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-media.mjs",
    "gen:names": "tsx scripts/gen-names.ts",
    "predev": "npm run gen:names --silent",
    "predev:media": "npm run gen:names --silent",
    "pretest": "npm run gen:names --silent",
    "prebuild": "npm run gen:names --silent",
    "premetrics": "npm run gen:names --silent",
    "premetrics:office": "npm run gen:names --silent"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "fflate": "0.8.3",
    "jsonc-parser": "^3.3.1",
    "jsqr": "1.4.0",
    "libphonenumber-js": "^1.13.15",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js-core": "6.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tesseract.js-data/ces": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "qrcode": "1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
